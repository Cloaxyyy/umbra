{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbra",
  "version": "1.0.1",
  "identifier": "app.umbra.launcher",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Umbra",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Umbra, a Roblox launcher",
    "publisher": "Umbra",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFOEMwRkFEMkUxN0E3RjUKUldUMXB4Y3VyUStNL3ViMkxuZjR5eThzYTM0TFhzSlF6ZzhnWHVJZTQ0T0lTNnlSSFU1Mm92VC8K",
      "endpoints": [
        "https://github.com/Cloaxyyy/umbra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}